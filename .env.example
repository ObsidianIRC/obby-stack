# Copy to .env and fill in.  All three Obby services consume from here.

# --- DNS / Traefik routing (Coolify auto-issues LE) ---
WEB_FQDN=chat.example.com
API_FQDN=api.example.com
IRC_FQDN=irc.example.com

# --- IRC server identity ---
SERVER_NAME=irc.example.com
NETWORK_NAME=ObbyNetwork
ADMIN_EMAIL=admin@example.com
MOTD_TEXT=Welcome to ObbyNetwork!

# --- oper credentials ---
OPER_NAME=admin
OPER_PASSWORD=                       # (secret) blank = auto-gen on first run, printed to log
OPER_MASK=*

# --- internal ports (rarely need to change) ---
SSL_PORT=6697
WS_PORT=8080

# --- optional features ---
FILEHOST_URL=
FILEHOST_PUBLIC_URL=                 # https://files.example.com (used by obby-api)

# --- IRCd RPC ---
RPC_PASSWORD=                        # (secret) shared with obby-api
RPC_PORT=8600

# --- cloak keys ---
CLOAK_KEY1=                          # (secret) 96 mixed a-zA-Z0-9 chars, blank = auto-gen
CLOAK_KEY2=                          # (secret)
CLOAK_KEY3=                          # (secret)

# --- backend JWT + shared key ---
JWT_SECRET=                          # (secret) openssl rand -hex 32
IRC_SERVER_KEY=                      # (secret) shared with obbyircd

# --- voice / TURN ---
VOICE_TURN_SECRET=                   # (secret) openssl rand -hex 32
VOICE_PUBLIC_IP=                     # public IP advertised in ICE candidates
TURN_PORT=3478                       # UDP, open in host firewall
VOICE_TURN_REALM=obby
VOICE_MAX_ROOM=25

# --- IRCd reachability (from obby-api) ---
UNREALIRCD_WS_URL=ws://obbyircd:8080
UNREALIRCD_API_USERNAME=admin

# --- image overrides ---
# Pin instead of :latest for reproducible deploys.
# OBBYIRCD_IMAGE=mattfly/obbyircd:v0.1.0
# OBBY_API_IMAGE=mattfly/obby-api:v0.1.0
# OBBY_WEB_IMAGE=mattfly/obby:v0.1.0

# --- frontend profile (opt-in) ---
# COMPOSE_PROFILES=frontend

# --- bind-mount overrides (optional) ---
# CONF_BIND=/srv/obby/conf
# DATA_BIND=/srv/obby/data
# LOGS_BIND=/srv/obby/logs
# TLS_BIND=/srv/obby/tls
# CUSTOM_MODULES_BIND=/srv/obby/custom-modules
# VOICE_BRIDGE_BIND=/srv/obby/voice-bridge
# OBBY_API_DATA_BIND=/srv/obby/obby-api-data
# OBBY_API_IMAGES_BIND=/srv/obby/obby-api-images
