# Copy to .env and fill in.  All three Obby services consume from here.

# --- DNS / Traefik routing (Coolify auto-issues LE) ---
WEB_FQDN=chat.example.com
API_FQDN=api.example.com

# --- IRC server identity ---
# SERVER_NAME must be a fully qualified hostname (contain a dot).
SERVER_NAME=irc.example.com
NETWORK_NAME=ObbyNetwork
ADMIN_EMAIL=admin@example.com
MOTD_TEXT=Welcome to ObbyNetwork!

# --- oper credentials ---
OPER_NAME=admin
# (secret) Blank = auto-generated on first run and printed once to the
# container log.  Set explicitly for stable credentials.
OPER_PASSWORD=
OPER_MASK=*

# --- internal ports (rarely need to change) ---
SSL_PORT=6697
WS_PORT=8080

# --- optional features ---
FILEHOST_URL=
# Set to e.g. https://files.example.com (used by obby-api for filehost links).
FILEHOST_PUBLIC_URL=

# --- IRCd RPC ---
# (secret) Shared with obby-api.
RPC_PASSWORD=
RPC_PORT=8600

# --- cloak keys ---
# (secret) Each = 80+ chars mixed a-zA-Z0-9.  Blank = auto-gen on first
# run (fine for single-node).  Set explicitly for linked nodes or stable
# cloaks across full volume resets.  Generate:
#   tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 96
CLOAK_KEY1=
CLOAK_KEY2=
CLOAK_KEY3=

# --- backend JWT + shared key ---
# (secret) JWT_SECRET: openssl rand -hex 32
# (secret) IRC_SERVER_KEY: shared with obbyircd, openssl rand -hex 32
JWT_SECRET=
IRC_SERVER_KEY=

# --- voice / TURN ---
# Default: obby-api runs an embedded pion/turn on TURN_PORT, signed
# with VOICE_TURN_SECRET (HMAC key). For coturn / other external TURN,
# set VOICE_TURN_EXTERNAL_URLS + VOICE_TURN_SHARED_SECRET below; the
# IRCd then rewrites the "joined" envelope's TURN field with HMAC
# creds for the external server, and you can stop the embedded one by
# setting VOICE_TURN_DISABLE_EMBEDDED=1.

# (secret) openssl rand -hex 32 -- only used by embedded path.
VOICE_TURN_SECRET=
# Public IP advertised in WebRTC ICE candidates (embedded path).
VOICE_PUBLIC_IP=
# UDP port for embedded TURN.  Must be open in host firewall.
TURN_PORT=3478
VOICE_TURN_REALM=obby
VOICE_MAX_ROOM=25

# External TURN. URLs space-separated on one line.
# VOICE_TURN_EXTERNAL_URLS="turn:turn.example.com:3478?transport=udp turn:turn.example.com:3478?transport=tcp"
# VOICE_TURN_SHARED_SECRET=          # (secret) coturn static-auth-secret
# VOICE_TURN_TTL=21600
# VOICE_TURN_DISABLE_EMBEDDED=1      # set when using external TURN to skip pion startup

# WebRTC ephemeral UDP port range pion gathers on.  Range MUST also
# be published in compose.yaml on obby-api.  Without these, clients
# behind NAT/coturn can't reach the SFU's server-side PC and video
# silently fails (audio survives via TURN relay).
# VOICE_WEBRTC_PORT_MIN=50000
# VOICE_WEBRTC_PORT_MAX=50100

# --- IRCd reachability (from obby-api) ---
UNREALIRCD_WS_URL=ws://obbyircd:8080
UNREALIRCD_API_USERNAME=admin

# --- image versions ---
# Per-service release tag. Renovate bumps the compose defaults via PR;
# set here only to override per environment.
# renovate: datasource=docker depName=obbyworld/obbyircd
# OBBYIRCD_VERSION=0.1.0
# renovate: datasource=docker depName=obbyworld/obby-api
# OBBY_API_VERSION=0.1.0
# renovate: datasource=docker depName=obbyworld/obby
# OBBY_WEB_VERSION=0.3.2
# renovate: datasource=docker depName=obbyworld/webpanel
# OBBY_PANEL_VERSION=0.1.0
# Or override the full image reference (registry/repo:tag):
# OBBYIRCD_IMAGE=obbyworld/obbyircd:0.1.0
# OBBY_API_IMAGE=obbyworld/obby-api:0.1.0
# OBBY_WEB_IMAGE=obbyworld/obby:0.3.2

# --- frontend profile (opt-in) ---
# COMPOSE_PROFILES=frontend

# --- admin webpanel (opt-in: --profile panel) ---
# Modern UnrealIRCd admin panel; connects to the IRCd over JSON-RPC on
# the internal docker network (ws://obbyircd:8080/, reuses RPC_PASSWORD).
PANEL_FQDN=panel.example.com
# (secret) JWT signing key for panel sessions: openssl rand -hex 32
PANEL_JWT_SECRET=
# Initial panel login, seeded on first run.
PANEL_ADMIN_USER=admin
# (secret) set a real password.
PANEL_ADMIN_PASSWORD=
# OBBY_PANEL_IMAGE=obbyworld/webpanel:0.1.0
# OBBY_PANEL_DATA_BIND=

# --- persistent state location ---
# Defaults bind-mount under ./data/* next to the compose file.  Set
# any of these to an absolute path for production layouts (e.g.
# /data/obby/conf).  All eight should live on the same host.
# CONF_BIND=
# DATA_BIND=
# LOGS_BIND=
# TLS_BIND=
# CUSTOM_MODULES_BIND=
# SCRIPTS_BIND=
# VOICE_BRIDGE_BIND=
# OBBY_API_DATA_BIND=
# OBBY_API_IMAGES_BIND=
